<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Subject</title>
    <link rel="stylesheet" href="/publics/css/style.css">
    <link rel="stylesheet" href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css">
    <link rel="stylesheet" href="../../publics/css/styleBody.css">
</head>
<body>
<div class="container">
    <form action="/addSubject" method="post">
        <h1>Add Subjects Page</h1>
        <div class="form-container">
            <input type="text" placeholder="Name of the subject " name="name" required>
        </div>
        <div class="form-container">
            <select name="teacherId" id="" required >
                <% teachers.forEach(function(teacher) { %>
                    <option value="<%= teacher.id %>"><strong>Mr(s) </strong> <%= teacher.nom %></option>
                <% }); %>
            </select>
        </div>
        <button type="submit" class="button">Add</button>&nbsp;&nbsp;&nbsp;
        <div class="return">
            <a href="/">Cancel</a>
        </div>
    </form>
</div>

</body>
</html>