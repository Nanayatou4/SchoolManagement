<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Sector</title>
    <link rel="stylesheet" href="/publics/css/style.css">
    <link rel="stylesheet" href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css">
    <link rel="stylesheet" href="../../publics/css/styleBody.css">
</head>
<body>
<div class="container" >
    <form action="/editSector/<% sectors.id %>?_method=PUT" method="post">
        <h1>Modify Sector Page</h1>
        <div class="form-container">
            <input type="text" placeholder="The name of the sector" value="<%=sector.Code%>"   name="Code_Acronyme" required>
        </div>
        <div class="form-container">
            <input type="text" placeholder="The generic name of the sector" value="<%=sector.generic_name%>"  name="generic_name" required>
        </div>
        <button type="submit" class="button">Edit</button>&nbsp;&nbsp;&nbsp;
        <div class="return">
            <a href="/">Cancel</a>
        </div>
    </form>
</div>
</body>
</html>