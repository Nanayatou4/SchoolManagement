<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sectors Management</title>
    <link rel="stylesheet" href="../../publics/css/style.css">
    <link rel="stylesheet" href="../../publics/css/style2.css">
    <link rel="stylesheet" href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css">
    <link rel="stylesheet" href="../../publics/css/bootstrap.css">
    <link rel="stylesheet" href="../../publics/css/styleBody.css">
</head>
<body>
<main class="form-container">
    <div class="text-center mt-5">
        <a href="/add_sector_page" style="margin-bottom: 4px;">Add sector</a>
        <a href="/adminPage" style="margin-bottom: 4px;">Return</a>
    </div>

    <table border style="width: 100%;" style="color: white;">
        <tr>
            <th>Name</th>
            <th>Generic name</th>
            <th>Actions</th>
        </tr>

        <% sectors.forEach(function(sector){ %>
            <tr>
                <td><%= sector.Code %></td>
                <td><%= sector.generic_name %></td>

                <td class="flex">
                    <a href="/edit_sector_page/<%=sector.Code%>">Modify</a>&nbsp;&nbsp;
                    <form method="post" action="/deleteSector?_method=DELETE" onsubmit="return confirm('Are you sure to delete this sector');" >
                        <input type="hidden" name="Code" value="<%=sector.Code%>">
                        <input class="submit" type="submit" value="Delete">
                    </form>
                </td>
            </tr>
        <% }); %>
    </table>
</main>
</body>
</html>