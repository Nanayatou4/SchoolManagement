<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Students Management</title>
    <link rel="stylesheet" href="../../publics/css/style.css">
    <link rel="stylesheet" href="../../publics/css/style2.css">
    <link rel="stylesheet" href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css">
    <link rel="stylesheet" href="../../publics/css/bootstrap-reboot.css">
    <link rel="stylesheet" href="../../publics/css/bootstrap.css">
</head>
<body>
<main class="form-container">
<div class="return">
            <a href="/adminPage">Cancel</a>
        </div>
    <table border style="width: 100%;">
        <tr>
            <th>Lastname</th>
            <th>Firstname</th>
            <th>Email</th>
            <th>Sector</th>
            <th>Action</th>
        </tr>

        <% students.forEach(function(student){ %>
            <tr>
                <td><%= student.nom %></td>
                <td><%= student.prenom %></td>
                <td><%= student.email %></td>
                <td><%= sector.nom %></td>
                <td class="flex">
                    <a href="<%=student.id%>">Modify</a>&nbsp;&nbsp;
                    <form method="post" action="/delete_student" onsubmit="return confirm('Are you sure to delete this student');" >

                        <input type="hidden" name="id" value="<%=student.id%>">
                        <input class="submit" type="submit" value="Delete">
                    </form>
                </td>
            </tr>
        <% }); %>

    </table>
</main>
</body>
</html>