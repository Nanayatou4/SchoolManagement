<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SIGN UP</title>
    <link rel="stylesheet" href="../../publics/css/style.css">
    <link rel="stylesheet" href="../../publics/css/styleBody.css">
    <link rel="stylesheet" href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css">
</head>
<body>
<div class="container" >
    <form method="post" action="/add-note/<%=student.id%>" >
        <h1>Add a note </h1>
        <div class="form-container">
            <label for="firstname">Firstname's student</label>
            <input type="text" name="date" placeholder="the name's student" value="<%=student.nom%>"  id="firstname" required>
        </div>
        <div class="form-container">
            <label for="lastname">Lastname's student</label>
            <input type="text" name="lastname" placeholder="Lastname's studen" value="<%=student.prenom%>" id="lastname" required>
        </div>
        <div class="form-container">
            <label for="desc">The apprciation's note</label>
            <input type="text" name="desc" placeholder="The apprciation's note" value="<%=student.prenom%>" id="desc" required>
        </div>
        <div class="form-container">
            <label for="value">The note value</label>
            <input type="number" name="note" placeholder="The note value" id="value" required>
        </div>
        <div class="form-container">
            <label for="date_exam">Exam of </label>
            <select name="exams" id="date_exam" required >
                <% exams.forEach(function(exam) { %>
                    <option name="id_exam" value="<%= exam.id %>"><%= exam.date %></option>
                <% }); %>
            </select>
        </div>
        <button type="submit" class="button">Save</button>
        <div class="return">
                    <a href="/students-notes">Cancel</a>
                </div>
    </form>
</div>
</body>
</html>